lakehouse/
reports/
**/__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
dbt/target/
dbt/dbt_packages/
dbt/logs/
logs/
metastore_db/
derby.log
spark-warehouse/
airflow/.astro/
.git/
.env
