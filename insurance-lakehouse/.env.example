# Copy to .env (gitignored) and adjust. Consumed by the Makefile and Spark jobs.
LAKEHOUSE_SEED=42
LAKEHOUSE_N_POLICIES=20000
LAKEHOUSE_BASE_DATE=2026-01-05
LAKEHOUSE_ROOT=./lakehouse
PII_SALT=change-me-local-only

# --- Databricks target (optional; never commit real values) ---
# Copy this file to .env, which is gitignored. Use a SHORT-EXPIRY token.
#
# HOST       Workspace URL without the scheme.
#            e.g. dbc-xxxxxxxx-xxxx.cloud.databricks.com
# HTTP_PATH  SQL Warehouses -> your warehouse -> Connection details.
#            e.g. /sql/1.0/warehouses/abc123def456
# TOKEN      Settings -> Developer -> Access tokens -> Generate new token.
# CATALOG    Created by `make databricks-load` if it does not exist.
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=insurance_dev
